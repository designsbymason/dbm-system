---
// The page type the site has (02-structure.md §3): full-width sections in the site's shell. The home page and the 404.
import { SiteShell } from "../components/shell/SiteShell";
import { facts } from "../components/home/facts";
import { componentPlacements } from "../data/placements";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <SiteShell client:load version={facts.version} placements={componentPlacements}>
    <slot />
  </SiteShell>
</Base>
