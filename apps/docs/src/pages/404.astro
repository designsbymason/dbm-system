---
// The 404: a short way back, in the site's shell.
import { allComponents, docsGroups, storybookHref } from "../data/site";
import { OpenSearchButton } from "../components/header/OpenSearchButton";
import Lost from "../illustrations/Lost.astro";
import Marketing from "../layouts/Marketing.astro";
---

<Marketing title="Page not found: DBM System" description="This page doesn't exist, or it moved." noindex>
  <section class="site-frame lost" aria-labelledby="lost-heading">
    <div class="lost__art"><Lost /></div>
    <h1 id="lost-heading" class="display lost__title">Nothing measured here</h1>
    <p class="lede">This page doesn't exist, or it moved. Search the docs, or take one of these ways in:</p>
    <OpenSearchButton client:load>Search the docs</OpenSearchButton>
    <ul class="lost__links">
      <li><a href="/">Home</a></li>
      <li><a href={docsGroups[0].links[0].href}>Introduction</a></li>
      <li><a href={docsGroups[0].links[1].href}>Installation</a></li>
      <li><a href={allComponents.href}>All components</a></li>
      <li><a href={storybookHref}>Storybook</a></li>
    </ul>
  </section>
</Marketing>

<style>
  .lost {
    display: grid;
    gap: var(--dbm-space-5);
    justify-items: start;
    padding-block: var(--dbm-space-16) var(--dbm-space-24);
  }
  .lost__art {
    inline-size: min(100%, 16rem);
  }
  .lost__title {
    font-size: var(--dbm-font-size-4xl);
  }
  .lost__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--dbm-space-3) var(--dbm-space-6);
  }
  .lost__links a {
    color: var(--dbm-text-link);
    text-underline-offset: 0.2em;
  }
  .lost__links a:focus-visible {
    outline: 2px solid var(--dbm-border-focus);
    outline-offset: 2px;
    border-radius: var(--dbm-radius-xs);
  }
</style>
