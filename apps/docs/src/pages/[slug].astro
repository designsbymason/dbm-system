---
// The pages at the root (the `pages` collection): AI agents and the Resources pages, in the Article layout.
import { getCollection, render } from "astro:content";
import CodeFence from "../components/content/CodeFence.astro";
import PageHead from "../components/content/PageHead.astro";
import PageNav from "../components/content/PageNav.astro";
import { groupOf } from "../data/site";
import Article from "../layouts/Article.astro";

export async function getStaticPaths() {
  const entries = await getCollection("pages");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = `/${entry.id}`;
const group = groupOf(path);
const outline = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ id: heading.slug, label: heading.text, level: (heading.depth === 2 ? 1 : 2) as 1 | 2 }));
const breadcrumbs = [{ label: "Home", href: "/" }, ...(group ? [{ label: group.label }] : []), { label: entry.data.title }];
---

<Article title={`${entry.data.title}: DBM System`} description={entry.data.description} section={path} outline={outline} breadcrumbs={breadcrumbs}>
  <PageHead title={entry.data.title} description={entry.data.description} />
  <div class="prose" data-pagefind-body>
    <Content components={{ CodeFence }} />
  </div>
  <PageNav path={path} />
</Article>
