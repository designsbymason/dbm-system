---
// A fenced code block in a page: DBM's CodeBlock, with highlighting for the built-in languages and a copy button.
// Hydrated when the page is idle, not when scrolled into view: the block makes a long line's scroll area keyboard-
// focusable once it runs, so one below the fold must be ready before a keyboard user tabs to it.
import { CodeBlock } from "@dbm-system/components";

interface Props {
  code: string;
  lang?: string;
}

const { code, lang } = Astro.props;
---

<div class="code-fence">
  <CodeBlock client:idle code={code} language={lang} copyable />
</div>
