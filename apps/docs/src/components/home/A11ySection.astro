---
// Section 6 (03-landing-page-brief.md §3): what every component guarantees, shown on a composition the reader can walk with Tab, resize
// and flip. Each row below quotes the Accessibility guide (the components' guarantees and their known exceptions are there).
import tokens from "@dbm-system/tokens/tokens.json" with { type: "json" };
import { accessibility, responsive } from "../../data/site";
import { A11yDemo } from "./A11yDemo";
import type { Width } from "./A11yDemo";

type Token = { name: string; group: string; value?: string };
const steps = (tokens.tokens as Token[])
  .filter((token) => token.group === "breakpoint" && token.value)
  .map((token) => ({ step: token.name.replace("--dbm-breakpoint-", ""), px: Number.parseInt(token.value ?? "0", 10) }))
  .sort((a, b) => a.px - b.px);
const step = (name: string) => {
  const found = steps.find((item) => item.step === name);
  if (!found) throw new Error(`A11ySection: no ${name} breakpoint in the token index`);
  return found;
};
const md = step("md");
const lg = step("lg");
/** Which layout a width lands in: the largest breakpoint at or below it, or the base layout. */
const layoutAt = (px: number) => {
  const reached = [...steps].reverse().find((item) => item.px <= px);
  return reached ? `${reached.step} and up` : "the base layout";
};
const widths: Width[] = [
  { label: "Phone", px: 375, step: layoutAt(375) },
  { label: "Tablet", px: md.px, step: layoutAt(md.px) },
  { label: "Desktop", px: lg.px, step: layoutAt(lg.px) },
];

const guarantees = [
  { term: "Keyboard", detail: "Every interaction works from the keyboard, with the focus model its pattern calls for." },
  { term: "Focus", detail: "A visible ring for keyboard focus, and focus that stays put when the layout changes under it." },
  { term: "Names", detail: "An accessible name and role on every interactive part, with a field's label, hint and error wired for you." },
  { term: "Contrast", detail: "4.5:1 for text and 3:1 for the parts that identify a control, in all four themes.", link: { href: accessibility.href, text: "Read the known exceptions" } },
  { term: "Target size", detail: "Every interactive target is at least 24 × 24 CSS pixels, at every size." },
  { term: "Any width, either direction", detail: "Every component works across the breakpoint scale and in left-to-right and right-to-left text.", link: { href: responsive.href, text: "Read the responsive guide" } },
];
---

<section id="accessible" class="a11y site-frame" aria-labelledby="a11y-heading">
  <div class="grid-12">
    <h2 id="a11y-heading" class="display a11y__title">Press Tab. Resize it. Flip it.</h2>
    <p class="lede a11y__lede">
      Every component takes the keyboard, a visible focus ring, an accessible name, AA contrast and any width in either direction. Walk the composition below with Tab, resize it, or read it right to left in Persian.
    </p>
    <div class="a11y__demo">
      <A11yDemo client:visible widths={widths} />
    </div>
    <dl class="a11y__list">
      {
        guarantees.map((row) => (
          <div class="a11y__row">
            <dt>{row.term}</dt>
            <dd>
              {row.detail}
              {row.link && (
                <>
                  {" "}
                  <a href={row.link.href}>{row.link.text}</a>
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .a11y {
    padding-block: var(--dbm-space-20);
  }

  .a11y__title,
  .a11y__lede,
  .a11y__demo,
  .a11y__list {
    grid-column: 1 / -1;
  }

  .a11y__title {
    font-size: var(--dbm-font-size-3xl);
    margin-block-end: var(--dbm-space-4);
  }

  .a11y__lede {
    margin-block-end: var(--dbm-space-8);
  }

  .a11y__list {
    margin: var(--dbm-space-10) 0 0;
    border-block-start: 1px solid var(--site-rule-strong);
  }

  .a11y__row {
    display: grid;
    gap: var(--dbm-space-1);
    padding-block: var(--dbm-space-4);
    border-block-end: 1px solid var(--site-rule);
  }

  dt {
    font-size: var(--dbm-font-size-sm);
    font-weight: var(--dbm-font-weight-semibold);
    color: var(--site-graphite);
  }

  dd {
    margin: 0;
  }

  dd a {
    color: var(--dbm-text-link);
    text-underline-offset: 0.2em;
  }

  dd a:focus-visible {
    outline: 2px solid var(--dbm-border-focus);
    outline-offset: 2px;
    border-radius: var(--dbm-radius-xs);
  }

  @media (min-width: 768px) {
    .a11y__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--dbm-space-6);
    }
  }

  @media (min-width: 1024px) {
    .a11y__title {
      grid-column: 1 / span 4;
      margin-block-end: 0;
    }

    .a11y__lede {
      grid-column: 5 / -1;
      margin-block-end: var(--dbm-space-10);
    }
  }
</style>
