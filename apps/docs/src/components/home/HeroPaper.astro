---
// The hero's illustration (03-landing-page-brief.md §3, ADR-0217, ADR-0222): a page of the manual. On desktop it glides down like a feather, in
// wide swings and slightly bent, showing a specimen of the primitive tokens while it falls; once it is in position the specimen breaks up and
// the JSON an agent reads resolves in its place (a real token entry, read from the token index at build). The page then turns, every few
// seconds, through the subtle backgrounds of the system (brand, warning, success, info, danger), each page tinted as its own token. It tilts,
// skews and lifts as the page scrolls and returns when it scrolls back, leans toward the pointer, and floats a little at rest. On a phone it
// does not fall or tilt: the specimen breaks into the JSON when the page scrolls into view.
// Everything that moves is added on top of a finished state, which is the base style: the first JSON page, still. Reduced motion, a browser
// without scroll timelines, or no script all get that complete page. It is a picture, so it is hidden from assistive technology and inert.
import tokens from "@dbm-system/tokens/tokens.json" with { type: "json" };

type Token = { name: string; layer: string; group: string; type: string; values: Record<string, string>; aliases: Record<string, string>; usedBy: string[] };

/** The pages of the manual: the subtle background of each tone, in the order the page turns. Each page is tinted as the token it shows. */
const tones = ["brand", "warning", "success", "info", "danger"];

/** The JSON of one real entry, line by line, as an agent reads it; the long `usedBy` list is cut after three names, as a trimmed excerpt. */
function jsonOf(token: Token): string[] {
  const used = token.usedBy.slice(0, 3);
  const entries = (record: Record<string, string>) =>
    Object.entries(record).map(([key, value], index, all) => `    "${key}": "${value}"${index < all.length - 1 ? "," : ""}`);
  return [
    "{",
    `  "name": "${token.name}",`,
    `  "layer": "${token.layer}",`,
    `  "group": "${token.group}",`,
    `  "type": "${token.type}",`,
    `  "values": {`,
    ...entries(token.values),
    `  },`,
    `  "aliases": {`,
    ...entries(token.aliases),
    `  },`,
    `  "usedBy": [`,
    ...used.map((name, index) => `    "${name}"${index < used.length - 1 || token.usedBy.length > used.length ? "," : ""}`),
    ...(token.usedBy.length > used.length ? [`    … ${token.usedBy.length - used.length} more`] : []),
    `  ]`,
    "}",
  ];
}

/** A line cut into runs the stylesheet can colour: the key, the string after it, and the punctuation. */
const runs = (line: string) => {
  const match = /^(\s*)("[^"]+")(: )?(.*)$/.exec(line);
  if (!match) return [{ text: line, kind: "punct" }];
  const [, indent = "", key = "", colon = "", rest = ""] = match;
  const out = [{ text: indent, kind: "punct" }, { text: key, kind: colon ? "key" : "string" }];
  if (colon) out.push({ text: colon, kind: "punct" });
  if (rest) out.push({ text: rest, kind: rest.startsWith('"') || rest.startsWith("[") ? "string" : "punct" });
  return out;
};

const pages = tones.map((tone) => {
  const token = (tokens.tokens as unknown as Token[]).find((candidate) => candidate.name === `--dbm-bg-${tone}-subtle`);
  if (!token) throw new Error(`HeroPaper: no --dbm-bg-${tone}-subtle in the token index`);
  return {
    bg: `var(--dbm-bg-${tone}-subtle)`,
    edge: `var(--dbm-border-${tone})`,
    accent: `var(--dbm-text-${tone})`,
    lines: jsonOf(token).map(runs),
  };
});
const first = pages[0];
if (!first) throw new Error("HeroPaper: no pages");

const ramp = ["50", "100", "200", "300", "400", "500", "600", "700", "800", "900", "950"];
const spaces = ["1", "2", "3", "4", "6", "8", "12"];
const radii = ["xs", "sm", "md", "lg", "xl"];
const sizes = ["xs", "sm", "base", "md", "lg", "xl"];
---


<div class="paper" aria-hidden="true" inert>
  <div class="paper__stage">
    <div class="paper__hover">
      <div class="paper__scroll">
        <div class="paper__fall">
          <div class="paper__turn">
            <div class="paper__shadow"></div>
            <div class="paper__sheet">
              <div class="paper__head">
                <span class="paper__file">tokens.json</span>
                <span class="paper__page">manual</span>
              </div>
              <pre class="paper__json"><code>{
                first.lines.map((line, index) => (
                  <span class="paper__line" style={`--i: ${index}`}>{line.map((run) => <span class={`paper__${run.kind}`}>{run.text}</span>)}</span>
                ))
              }</code></pre>
              <div class="paper__ui">
                <div class="paper__block" style="--k: 0">
                  <p class="paper__label"><span class="token-name">color.purple.50 to 950</span></p>
                  <div class="paper__ramp">
                    {ramp.map((step) => <span style={`background: var(--dbm-color-purple-${step})`}></span>)}
                  </div>
                </div>
                <div class="paper__block" style="--k: 1">
                  <p class="paper__label"><span class="token-name">space.1 to 12</span></p>
                  <div class="paper__spaces">
                    {spaces.map((step) => <span style={`inline-size: var(--dbm-space-${step})`}></span>)}
                  </div>
                </div>
                <div class="paper__row">
                  <div class="paper__block" style="--k: 2">
                    <p class="paper__label"><span class="token-name">radius.xs to xl</span></p>
                    <div class="paper__radii">
                      {radii.map((step) => <span style={`border-radius: var(--dbm-radius-${step})`}></span>)}
                    </div>
                  </div>
                  <div class="paper__block" style="--k: 3">
                    <p class="paper__label"><span class="token-name">shadow.xs to md</span></p>
                    <div class="paper__shadows">
                      <span class="paper__tile paper__tile--xs"></span>
                      <span class="paper__tile paper__tile--sm"></span>
                      <span class="paper__tile paper__tile--md"></span>
                    </div>
                  </div>
                </div>
                <div class="paper__block" style="--k: 4">
                  <p class="paper__label"><span class="token-name">font.size.xs to xl</span></p>
                  <div class="paper__type">
                    {sizes.map((step) => <span style={`font-size: var(--dbm-font-size-${step})`}>Aa</span>)}
                  </div>
                </div>
              </div>
              <div class="paper__sheen"></div>
              <div class="paper__sweep"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" class="paper__pages" set:html={JSON.stringify(pages)} />
</div>

<script is:inline>
  // Runs as the markup is parsed, before the first paint, so there is no flash. Everything here is for a reader who has not asked for reduced
  // motion; without it the page is one flat sheet and still complete.
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains("paper")) return;
    var motion = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
    if (!motion) return;

    // On a phone the page is below the first screen: the specimen waits, and breaks into the JSON once the page scrolls into view.
    if (!window.matchMedia("(min-width: 768px)").matches) {
      root.classList.add("paper--wait");
      if (!("IntersectionObserver" in window)) {
        root.classList.remove("paper--wait");
        return;
      }
      var watcher = new IntersectionObserver(
        function (entries) {
          if (entries[0] && entries[0].isIntersecting) {
            root.classList.remove("paper--wait");
            watcher.disconnect();
          }
        },
        { threshold: 0.4 },
      );
      watcher.observe(root);
      return;
    }

    // The stylesheet is scoped by an attribute the page's own elements carry; the elements made here need it too.
    var scope = "";
    for (var a = 0; a < root.attributes.length; a += 1) if (root.attributes[a].name.indexOf("data-astro-cid-") === 0) scope = root.attributes[a].name;
    function make(tag, className) {
      var node = document.createElement(tag);
      node.className = className;
      if (scope) node.setAttribute(scope, "");
      return node;
    }

    // 1. The bend: the sheet is cut into hinged strips, each turned a little more than the last, so it curves as it falls. Each strip holds a
    //    copy of the sheet, shifted to show its own slice. The strips straighten to nothing as the page lands.
    var turn = root.querySelector(".paper__turn");
    var sheet = turn && turn.querySelector(".paper__sheet");
    var count = 5;
    if (turn && sheet) {
      root.style.setProperty("--n", String(count));
      var previous = null;
      for (var index = 0; index < count; index += 1) {
        var strip = make("div", "paper__strip");
        var win = make("div", "paper__win");
        var part = index === 0 ? sheet : sheet.cloneNode(true);
        part.style.setProperty("--part", String(index));
        win.appendChild(part);
        strip.appendChild(win);
        (previous || turn).appendChild(strip);
        previous = strip;
      }
    }

    // 2. The parallax: once the page has landed it leans toward the pointer and its layers shift a little against each other.
    var hero = root.closest(".hero") || root;
    var stage = root.querySelector(".paper__stage");
    var target = { x: 0, y: 0, near: 0 };
    var current = { x: 0, y: 0, near: 0 };
    var frame = 0;
    var landed = false;
    function draw() {
      current.x += (target.x - current.x) * 0.1;
      current.y += (target.y - current.y) * 0.1;
      current.near += (target.near - current.near) * 0.1;
      root.style.setProperty("--mx", current.x.toFixed(3));
      root.style.setProperty("--my", current.y.toFixed(3));
      root.style.setProperty("--near", current.near.toFixed(3));
      var settled = Math.abs(target.x - current.x) + Math.abs(target.y - current.y) + Math.abs(target.near - current.near) < 0.002;
      frame = settled ? 0 : window.requestAnimationFrame(draw);
    }
    function ask() {
      if (!frame) frame = window.requestAnimationFrame(draw);
    }
    function clamp(value) {
      return Math.max(-1, Math.min(1, value));
    }
    hero.addEventListener("pointermove", function (event) {
      if (!landed || event.pointerType !== "mouse" || !stage) return;
      var box = stage.getBoundingClientRect();
      target.x = clamp(((event.clientX - (box.left + box.width / 2)) / box.width) * 1.6);
      target.y = clamp(((event.clientY - (box.top + box.height / 2)) / box.height) * 1.6);
      target.near = event.clientX > box.left && event.clientX < box.right && event.clientY > box.top && event.clientY < box.bottom ? 1 : 0;
      ask();
    });
    hero.addEventListener("pointerleave", function () {
      target.x = 0;
      target.y = 0;
      target.near = 0;
      ask();
    });

    // 3. Turning the page: every few seconds it turns, like a card, to the next page of the manual. Each page is tinted as the token it shows.
    var pages = [];
    try {
      pages = JSON.parse(root.querySelector(".paper__pages").textContent);
    } catch (error) {
      pages = [];
    }
    var visible = true;
    var turning = false;
    var shown = 0;
    var relockTimer = 0;
    function show(page) {
      root.style.setProperty("--paper-bg", page.bg);
      root.style.setProperty("--paper-edge", page.edge);
      root.style.setProperty("--paper-accent", page.accent);
      root.classList.add("paper--cycled", "paper--relock");
      var codes = root.querySelectorAll(".paper__json code");
      for (var c = 0; c < codes.length; c += 1) {
        codes[c].textContent = "";
        for (var n = 0; n < page.lines.length; n += 1) {
          var line = make("span", "paper__line");
          line.style.setProperty("--i", String(n));
          for (var r = 0; r < page.lines[n].length; r += 1) {
            var run = make("span", "paper__" + page.lines[n][r].kind);
            run.textContent = page.lines[n][r].text;
            line.appendChild(run);
          }
          codes[c].appendChild(line);
        }
      }
      window.clearTimeout(relockTimer);
      relockTimer = window.setTimeout(function () {
        root.classList.remove("paper--relock");
      }, 2400);
    }
    function next() {
      if (pages.length < 2 || !turn) return;
      if (turning || document.hidden || !visible) {
        window.setTimeout(next, 1500);
        return;
      }
      turning = true;
      shown = (shown + 1) % pages.length;
      var away = turn.animate([{ transform: "rotateY(0deg)" }, { transform: "rotateY(-90deg)" }], { duration: 430, easing: "cubic-bezier(0.5, 0, 0.9, 0.6)", fill: "forwards" });
      away.onfinish = function () {
        show(pages[shown]);
        var back = turn.animate([{ transform: "rotateY(90deg)" }, { transform: "rotateY(0deg)" }], { duration: 560, easing: "cubic-bezier(0.2, 0.6, 0.3, 1)", fill: "forwards" });
        back.onfinish = function () {
          away.cancel();
          back.cancel();
          turning = false;
          window.setTimeout(next, 6200);
        };
      };
    }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        visible = !!(entries[0] && entries[0].isIntersecting);
      }).observe(root);
    }
    root.addEventListener("animationend", function (event) {
      if (event.animationName !== "paper-fall") return;
      landed = true;
      // The first page has been read by the time the JSON has resolved; the page turns a little after that.
      window.setTimeout(next, 4800);
    });
  })();
</script>

<style>
  /*
   * The finished state is the base style: the first JSON page, drawn still. Everything that moves is added below, inside `prefers-reduced-motion:
   * no-preference`, so a reader who asked for no motion (or a browser that cannot animate) gets the complete page.
   */
  @property --bend {
    syntax: "<angle>";
    inherits: true;
    initial-value: 0deg;
  }

  /* The page glides in wide swings, so it passes beyond the hero's own column for a moment; the viewport's edge, not a scrollbar, is where it stops. */
  :global(body) {
    overflow-x: clip;
  }

  .paper {
    /* When each part of the sequence begins. The fall takes --fall; the specimen breaks up as the page lands; the JSON resolves in its place. */
    --fall: 4.6s;
    --t0: calc(var(--fall) + 0.4s);
    --n: 1;
    --paper-w: min(100%, 23rem);
    display: grid;
    place-items: center;
    --paper-sh-xs: var(--dbm-shadow-light-xs);
    --paper-sh-sm: var(--dbm-shadow-light-sm);
    --paper-sh-md: var(--dbm-shadow-light-md);
  }

  :global(:root[data-theme$="-dark"]) .paper {
    --paper-sh-xs: var(--dbm-shadow-dark-xs);
    --paper-sh-sm: var(--dbm-shadow-dark-sm);
    --paper-sh-md: var(--dbm-shadow-dark-md);
  }

  .paper__stage {
    inline-size: var(--paper-w);
    container-type: inline-size;
    perspective: 1100px;
  }

  .paper__hover,
  .paper__scroll,
  .paper__fall,
  .paper__turn,
  .paper__strip {
    transform-style: preserve-3d;
  }

  /* Leaning toward the pointer: a turn, a small shift and, over the page itself, a slight lift. All zero at rest. */
  .paper__hover {
    transform: translate3d(calc(var(--mx, 0) * var(--dbm-space-3)), calc(var(--my, 0) * var(--dbm-space-3)), 0)
      scale(calc(1 + var(--near, 0) * 0.02)) rotateY(calc(var(--mx, 0) * 9deg)) rotateX(calc(var(--my, 0) * -7deg));
  }

  .paper__turn {
    position: relative;
  }

  /* The depth on the page behind. It is the sheet's own outline with its shadow, inside the turning sheet, so it turns with it; it is shown
     only once the page is down (a shadow under a page in the air would be a flat shape that does not follow it). */
  .paper__shadow {
    position: absolute;
    inset: 0;
    border-radius: var(--dbm-radius-md);
    box-shadow: var(--site-shadow-plate);
    transform: translateZ(-1px);
  }

  /* The bend. The strips turn a little each, hinged on their near edge; --bend is the sum, and it is nothing when the page is flat. */
  .paper__strip {
    position: relative;
    inline-size: 100%;
    transform-origin: left center;
    transform: rotateY(calc(var(--bend) / var(--n)));
  }

  .paper__turn > .paper__strip {
    inline-size: calc(100% / var(--n));
  }

  .paper__strip > .paper__strip {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 100%;
  }

  .paper__win {
    inline-size: calc(100% + 1px);
    block-size: 100%;
    overflow: hidden;
  }

  .paper__win > .paper__sheet {
    inline-size: 100cqw;
    transform: translateX(calc(var(--part, 0) * -100cqw / var(--n)));
  }

  /* The page is tinted as the token it shows: `--paper-bg`, `--paper-edge` and `--paper-accent` are set as it turns, and are brand's until then. */
  .paper__sheet {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    background: var(--paper-bg, var(--dbm-bg-brand-subtle));
    border: 1px solid var(--paper-edge, var(--dbm-border-brand));
    border-radius: var(--dbm-radius-md);
  }

  .paper__head {
    display: flex;
    justify-content: space-between;
    padding: var(--dbm-space-3) var(--dbm-space-5);
    border-block-end: 1px solid color-mix(in srgb, var(--paper-edge, var(--dbm-border-brand)) 35%, transparent);
    font-family: var(--dbm-font-family-mono);
    font-size: var(--dbm-font-size-xs);
    color: var(--site-graphite);
    translate: calc(var(--mx, 0) * var(--dbm-space-1)) calc(var(--my, 0) * var(--dbm-space-1));
  }

  .paper__file {
    color: var(--paper-accent, var(--dbm-text-brand));
  }

  /* The JSON an agent reads: the finished state. */
  .paper__json {
    grid-area: 2 / 1;
    align-self: center;
    margin: 0;
    padding: var(--dbm-space-4) var(--dbm-space-3);
    font-family: var(--dbm-font-family-mono);
    font-size: var(--dbm-font-size-xs);
    line-height: var(--dbm-line-height-snug);
    white-space: normal;
    color: var(--site-graphite);
    translate: calc(var(--mx, 0) * var(--dbm-space-2)) calc(var(--my, 0) * var(--dbm-space-2));
  }

  /* Each line keeps its own spaces; the newlines between the generated elements are not part of the JSON. */
  .paper__line {
    display: block;
    white-space: pre;
  }

  .paper__key {
    color: var(--site-ink);
  }

  .paper__string {
    color: var(--paper-accent, var(--dbm-text-brand));
  }

  .paper__punct {
    color: var(--site-graphite);
  }

  /* The specimen of the primitive tokens, drawn with the tokens. Shown while the page falls, not in the finished state. */
  .paper__ui {
    display: none;
    grid-area: 2 / 1;
    align-content: space-evenly;
    gap: var(--dbm-space-4);
    padding: var(--dbm-space-5);
    translate: calc(var(--mx, 0) * var(--dbm-space-3)) calc(var(--my, 0) * var(--dbm-space-3));
  }

  .paper__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--dbm-space-5);
  }

  .paper__block {
    display: grid;
    gap: var(--dbm-space-2);
    min-inline-size: 0;
  }

  .paper__label {
    margin: 0;
  }

  .paper__ramp {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    border-radius: var(--dbm-radius-sm);
    overflow: hidden;
    border: 1px solid var(--dbm-border-brand-subtle);
  }

  .paper__ramp span {
    block-size: var(--dbm-space-10);
  }

  .paper__spaces {
    display: flex;
    align-items: flex-end;
    gap: var(--dbm-space-2);
  }

  .paper__spaces span {
    display: block;
    block-size: var(--dbm-space-3);
    background: var(--dbm-bg-brand);
    border-radius: var(--dbm-radius-xs);
  }

  .paper__radii {
    display: flex;
    gap: var(--dbm-space-2);
  }

  .paper__radii span {
    display: block;
    inline-size: var(--dbm-space-6);
    block-size: var(--dbm-space-6);
    border: 2px solid var(--dbm-border-brand);
    background: var(--dbm-bg-surface);
  }

  .paper__shadows {
    display: flex;
    gap: var(--dbm-space-3);
    padding-block: var(--dbm-space-1);
  }

  .paper__tile {
    display: block;
    inline-size: var(--dbm-space-6);
    block-size: var(--dbm-space-6);
    background: var(--dbm-bg-surface);
    border-radius: var(--dbm-radius-sm);
  }

  .paper__tile--xs {
    box-shadow: var(--paper-sh-xs);
  }

  .paper__tile--sm {
    box-shadow: var(--paper-sh-sm);
  }

  .paper__tile--md {
    box-shadow: var(--paper-sh-md);
  }

  .paper__type {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-family: var(--dbm-font-family-secondary);
    line-height: 1;
    color: var(--site-ink);
  }

  /* The light on the paper: a soft highlight that follows the pointer, and one sweep across the sheet when the JSON has resolved. Neither is
     drawn in the finished state. The highlight and the sweep are the surface colour, so they follow light and dark. */
  .paper__sheen,
  .paper__sweep {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .paper__sheen {
    opacity: calc(var(--near, 0) * 0.7);
    background: radial-gradient(
      circle at calc(50% + var(--mx, 0) * 45%) calc(45% + var(--my, 0) * 45%),
      color-mix(in srgb, var(--dbm-bg-surface) 65%, transparent),
      transparent 58%
    );
  }

  .paper__sweep {
    transform: translateX(-130%);
    background: linear-gradient(105deg, transparent 38%, color-mix(in srgb, var(--dbm-bg-surface) 70%, transparent) 50%, transparent 62%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .paper__ui {
      display: grid;
    }

    .paper__sweep {
      display: block;
    }

    @media (hover: hover) and (min-width: 768px) {
      .paper__sheen {
        display: block;
      }
    }

    /* On a phone the page does not fall or tilt: it is already in place, and the specimen breaks into the JSON once it scrolls into view. */
    @media (max-width: 767px) {
      .paper {
        --fall: 0s;
        --t0: 0.35s;
      }
    }

    @media (min-width: 768px) {
      .paper__fall {
        animation: paper-fall var(--fall) cubic-bezier(0.37, 0, 0.3, 1) both;
      }

      /* A page lying on a surface casts a shadow; one in the air does not, so it comes in as the page touches down, with a small pulse. */
      .paper__shadow {
        animation: paper-shadow var(--fall) ease-out both;
      }

      /* Once it is down it floats, barely: a few pixels over several seconds. */
      .paper__turn {
        animation: paper-float 7s ease-in-out infinite alternate;
        animation-delay: var(--fall);
      }
    }

    /* The specimen breaks up block by block, in coarse steps, like a signal losing its lock... */
    .paper__block {
      animation: paper-break 0.8s steps(6, end) both;
      animation-delay: calc(var(--t0) + var(--k) * 90ms);
    }

    /* ...and the JSON resolves in its place, line by line, top to bottom. */
    .paper__line {
      animation: paper-lock 0.9s steps(7, end) both;
