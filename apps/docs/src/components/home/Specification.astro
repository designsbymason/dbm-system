---
// The facts, as three cards (what it is, what it needs, how it is built) with a drawing in brand shades at the top of each, rather than a strip of
// big numbers. Every value is read from the packages at build (facts.ts). The section has no visible title; its heading is there for the
// page's outline and for assistive technology.
import { facts } from "./facts";
import { SpecCards } from "./SpecCards";
import type { SpecGroup } from "./SpecCards";

const list = (items: string[]) =>
  items.length < 2 ? items.join("") : `${items.slice(0, -1).join(", ")} and ${items.at(-1)}`;

const groups: SpecGroup[] = [
  {
    title: "What it is",
    art: "is",
    rows: [
      { term: "Exports", detail: `${facts.componentCount} components and ${facts.utilityCount} hooks/functions` },
      { term: "Themes", detail: `${list(facts.brands)}, each in ${list(facts.modes)}` },
      { term: "Version", detail: facts.version },
    ],
  },
  {
    title: "What it needs",
    art: "needs",
    rows: [
      { term: "React", detail: `${facts.react.replace(">=", "")} and later, safe to render on the server` },
      { term: "Runtime dependencies", detail: list(facts.thirdParty) },
      { term: "Licence", detail: "MIT" },
    ],
  },
  {
    title: "How it is built",
    art: "built",
    rows: [
      { term: "Accessibility", detail: "WCAG 2.2 AA is the goal, checked on every change." },
      { term: "For agents", detail: "A typed component manifest, a token index and AGENTS.md ship in the packages, and an MCP server answers questions from them" },
    ],
  },
];
---

<section class="spec site-frame" aria-labelledby="spec-heading">
  <h2 id="spec-heading" class="visually-hidden">Specification</h2>
  <SpecCards groups={groups} />
</section>

<script is:inline>
  // The drawings play when they scroll into view, from either direction, and are held back again when they leave, so they play again when they
  // return. Only for a reader who has not asked for reduced motion; otherwise the drawings stay as they are, finished (SpecArt.tsx).
  (function () {
    if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches || !("IntersectionObserver" in window)) return;
    var arts = document.querySelectorAll(".spec [data-art]");
    if (arts.length === 0) return;
    var watcher = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) entry.target.setAttribute("data-seen", "");
          else entry.target.removeAttribute("data-seen");
        });
      },
      { threshold: 0.4 },
    );
    arts.forEach(function (art) {
      art.setAttribute("data-armed", "");
      watcher.observe(art);
    });
  })();
</script>

<style>
  .spec {
    padding-block: var(--site-section-space);
  }
</style>
