---
// "Change the theme, not the components": one composition in each of the four themes. With scroll
// timelines and motion allowed, the section holds still while the themes change in turn as the reader
// scrolls (the page's second scroll moment); otherwise the four sit side by side. The themes are the
// token files themselves, re-scoped to a wrapper at build (scripts/scoped-themes.mjs).
import "../../styles/generated/scoped-themes.css";
import { facts, tokenValues } from "./facts";
import { ThemeComposition } from "./ThemeComposition";
import { ThemeSwitcher } from "./ThemeSwitcher";

const brand = tokenValues("--dbm-bg-brand");
const surface = tokenValues("--dbm-bg-surface");
const brands = facts.themes.map((t) => t.split("-")[0]).filter((b, i, all) => all.indexOf(b) === i);
const modes = facts.themes.map((t) => t.split("-")[1]).filter((m, i, all) => all.indexOf(m) === i);
// The themes in the order the section steps through them. In light mode that is the token order (each brand light, then dark); when the
// reader's mode is dark each brand starts from its dark theme, so Purple dark comes first. Both orders are in the HTML and CSS picks one by
// the page's mode (`html[data-mode]`), so switching the mode in the header re-orders the section with no script.
const lightOrder = facts.themes;
const darkOrder = brands.flatMap((b) => [...modes].reverse().map((m) => `${b}-${m}`)).filter((t) => facts.themes.includes(t));
// What a slot is: the first holds still at the start, the last at the end, every other fades in and out.
const position = (slot: number) => (slot === 0 ? "first" : slot === lightOrder.length - 1 ? "last" : "step");
const label = (theme: string) => {
  const [b, m] = theme.split("-");
  return `${b[0].toUpperCase()}${b.slice(1)}, ${m}`;
};
---

<section class="themes" aria-labelledby="themes-heading" data-themes>
  <div class="themes__run">
    <div class="themes__stage site-frame">
      <div class="grid-12 themes__grid">
        <div class="themes__text">
          <h2 id="themes-heading" class="display themes__title">Change the theme, not the components</h2>
          <p class="lede">
            {`Every component reads the same semantic tokens. Load another theme file and the whole interface follows: ${facts.brands.length} brands, each in light and dark, and not one component changed.`}
          </p>
          <div class="themes__switch">
            <ThemeSwitcher client:visible themes={facts.themes} brands={brands} modes={modes} />
          </div>
          <table class="themes__readout">
            <caption class="visually-hidden">The value of two tokens in each theme</caption>
            <thead>
              <tr>
                <th scope="col">Theme</th>
                <th scope="col"><span class="token-name">bg.brand</span></th>
                <th scope="col"><span class="token-name">bg.surface</span></th>
              </tr>
            </thead>
            {
              [
                ["light", lightOrder],
                ["dark", darkOrder],
              ].map(([order, themes]) => (
                <tbody data-order={order}>
                  {(themes as string[]).map((theme, index) => (
                    <tr class="themes__row" data-theme-key={theme} style={`--i: ${index}; --row-anim: row-${position(index)}`}>
                      <th scope="row">{label(theme)}</th>
                      <td>
                        <span class="themes__swatch" style={`background: ${brand[theme]}`} />
                        <code>{brand[theme]}</code>
                      </td>
                      <td>
                        <span class="themes__swatch" style={`background: ${surface[theme]}`} />
                        <code>{surface[theme]}</code>
                      </td>
                    </tr>
                  ))}
                </tbody>
              ))
            }
          </table>
        </div>
        <div class="themes__copies" aria-hidden="true" inert>
          {
            facts.themes.map((theme) => (
              <figure
                class="themes__copy"
                data-theme-scope={theme}
                data-theme-key={theme}
                style={`--slot-light: ${lightOrder.indexOf(theme)}; --slot-dark: ${darkOrder.indexOf(theme)}; --anim-light: theme-${position(lightOrder.indexOf(theme))}; --anim-dark: theme-${position(darkOrder.indexOf(theme))}`}
              >
                <ThemeComposition id={theme} />
                <figcaption>{label(theme)}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .themes {
    background: var(--site-sheet);
  }

  .themes__stage {
    padding-block: var(--site-section-space);
  }

  .themes__grid {
    row-gap: var(--dbm-space-12);
    align-items: start;
  }

  .themes__text {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--dbm-space-4);
    align-content: start;
  }

  .themes__title {
    font-size: var(--dbm-font-size-3xl);
  }

  /* The sentence is followed by the controls (and then the readout) at the page's sentence-to-content distance: its own gap and this. */
  .themes__switch,
  .themes__readout {
    margin-block-start: var(--dbm-space-4);
  }

  .themes__readout {
    border-collapse: collapse;
    font-size: var(--dbm-font-size-sm);
    inline-size: 100%;
  }

  .themes__readout th,
  .themes__readout td {
    text-align: start;
    padding-block: var(--dbm-space-2);
    padding-inline-end: var(--dbm-space-4);
    border-block-end: 1px solid var(--site-rule);
    font-weight: var(--dbm-font-weight-regular);
  }

  .themes__readout thead th {
    color: var(--site-graphite);
    font-weight: var(--dbm-font-weight-semibold);
  }

  .themes__readout code {
    font-family: var(--dbm-font-family-mono);
    font-size: var(--dbm-font-size-xs);
  }

  .themes__swatch {
    display: inline-block;
    inline-size: var(--dbm-space-3);
    block-size: var(--dbm-space-3);
    border-radius: var(--dbm-radius-xs);
    border: 1px solid var(--site-rule);
    vertical-align: middle;
    margin-inline-end: var(--dbm-space-2);
  }

  /* Static: the four copies side by side. */
  .themes__copies {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--dbm-space-6);
  }

  .themes__copy {
    margin: 0;
    display: grid;
    gap: var(--dbm-space-3);
    padding: var(--dbm-space-4);
    border-radius: var(--dbm-radius-xl);
    background: var(--dbm-bg-neutral-subtle);
    color: var(--dbm-text-primary);
  }

  /* The themes' order follows the page's mode: each brand starts from its dark theme when the mode is dark, so Purple dark is first. The copies
     take their slot (and, when scrolled, their fade) from the property pair for the mode; the readout has a body for each order and shows one. */
  .themes__copy {
    --slot: var(--slot-light);
    --anim: var(--anim-light);
    order: var(--slot);
  }

  :global(html[data-mode="dark"]) .themes__copy {
    --slot: var(--slot-dark);
    --anim: var(--anim-dark);
  }

  .themes__readout tbody[data-order="dark"],
  :global(html[data-mode="dark"]) .themes__readout tbody[data-order="light"] {
    display: none;
  }

  :global(html[data-mode="dark"]) .themes__readout tbody[data-order="dark"] {
    display: table-row-group;
  }

  .themes__copy figcaption {
    font-size: var(--dbm-font-size-xs);
    color: var(--dbm-text-secondary);
  }

  @media (min-width: 768px) {
    .themes__copies {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* With the controls running (they set `data-picked`), one composition shows, the picked one, and its readout row is marked. */
  .themes[data-picked] .themes__copies {
    grid-template-columns: minmax(0, 1fr);
  }

  .themes[data-picked] .themes__copy:not([data-on]) {
    display: none;
  }

  .themes__row[data-on] th,
  .themes__row[data-on] td {
    color: var(--site-ink);
    font-weight: var(--dbm-font-weight-semibold);
  }

  /* Below the two-column layout the controls, the composition they change and then the readout follow one another, so a choice is seen where it
     is made. The text block steps aside (`display: contents`) so its parts can be ordered around the copies. */
  @media (max-width: 1023.98px) {
    .themes__grid {
      row-gap: var(--dbm-space-4);
    }

    .themes__text {
      display: contents;
    }

    .themes__text > * {
      grid-column: 1 / -1;
    }

    .themes__copies {
      order: 1;
      margin-block: var(--dbm-space-4);
    }

    .themes__readout {
      order: 2;
    }
  }

  @media (min-width: 1024px) {
    .themes__text {
      grid-column: 1 / span 5;
    }
    .themes__copies {
      grid-column: 7 / -1;
    }
  }

  /* Scrolled: the stage holds still and the themes change in turn. Wide screens only, where the stage fits the window. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
      .themes__switch {
        display: none;
      }

      .themes[data-picked] .themes__copy:not([data-on]) {
        display: grid;
      }

      .themes__row[data-on] th,
      .themes__row[data-on] td {
        color: inherit;
        font-weight: var(--dbm-font-weight-regular);
      }

      .themes__run {
        block-size: 360vh;
        view-timeline: --themes block;
      }

      .themes__stage {
        position: sticky;
        inset-block-start: var(--dbm-space-16);
      }

      .themes__copies {
        grid-template-columns: 1fr;
        display: grid;
      }

      /* The fade and the slot come from the properties for the page's mode: the first copy and its row hold at the start and the last at the end
         (the first is marked from the start, the last to the end), every other fades in and out. */
      .themes__copy {
        grid-area: 1 / 1;
        opacity: 0;
        animation: theme-step linear both;
        animation-name: var(--anim);
        animation-timeline: --themes;
        animation-range: contain calc(var(--slot) * 25%) contain calc((var(--slot) + 1) * 25%);
      }

      .themes__row {
        animation: row-step linear both;
        animation-name: var(--row-anim);
        animation-timeline: --themes;
        animation-range: contain calc(var(--i) * 25%) contain calc((var(--i) + 1) * 25%);
      }

      @keyframes theme-step {
        0% { opacity: 0; }
        12%, 88% { opacity: 1; }
        100% { opacity: 0; }
      }

      @keyframes theme-first {
        0%, 88% { opacity: 1; }
        100% { opacity: 0; }
      }

      @keyframes theme-last {
        0% { opacity: 0; }
        12%, 100% { opacity: 1; }
      }

      @keyframes row-step {
        0%, 100% { color: var(--site-pencil); }
        12%, 88% { color: var(--site-ink); }
      }

      @keyframes row-first {
        0%, 88% { color: var(--site-ink); }
        100% { color: var(--site-pencil); }
      }

      @keyframes row-last {
        0% { color: var(--site-pencil); }
        12%, 100% { color: var(--site-ink); }
      }
    }
  }
</style>
