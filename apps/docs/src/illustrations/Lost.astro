  <g transform="translate(80 62)">
    <path class="paper" d="M0 22 L60 -8 L0 -38 L-60 -8 Z" />
    <path class="edge" d="M0 22 L60 -8 L0 -38 L-60 -8 Z" stroke-dasharray="4 5" />
    <path class="ink-line" d="M-60 4 L0 34 M-60 0 V8 M0 30 V38" />
    <circle class="wash-strong" cx="0" cy="-8" r="6" />
  </g>
</svg>
