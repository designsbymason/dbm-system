{
  "name": "@dbm-system/manifest",
  "version": "0.0.0",
  "description": "Build tool that generates the agent-readable JSON component manifest from TypeScript + JSDoc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designsbymason/dbm-system.git",
    "directory": "packages/manifest"
  },
  "homepage": "https://dbm-system.com",
  "bugs": {
    "url": "https://github.com/designsbymason/dbm-system/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dbm-manifest": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./manifest.schema.json": "./schema/manifest.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "react-docgen-typescript": "^2.4.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@dbm-system/eslint-config": "workspace:*",
    "@dbm-system/tsconfig": "workspace:*",
    "@types/node": "^24.13.3",
    "eslint": "^10.14.0",
    "react-docgen": "^8.0.4",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
