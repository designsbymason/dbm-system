{
  "name": "@dbm-system/tokens",
  "version": "0.0.0",
  "description": "Design tokens (primitive, semantic, and component layers) for the DBM System.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designsbymason/dbm-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://dbm-system.com",
  "bugs": {
    "url": "https://github.com/designsbymason/dbm-system/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css/*.css": "./build/css/*.css"
  },
  "files": [
    "dist",
    "build/css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node style-dictionary.config.js && tsup"
  },
  "devDependencies": {
    "@dbm-system/tsconfig": "workspace:*",
    "culori": "^4.0.2",
    "style-dictionary": "^5.8.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
