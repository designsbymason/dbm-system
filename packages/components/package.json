{
  "name": "@dbm-system/components",
  "version": "0.0.0",
  "description": "The DBM System React component library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designsbymason/dbm-system.git",
    "directory": "packages/components"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . && pnpm typecheck && pnpm typecheck:storybook",
    "typecheck": "tsc --noEmit",
    "typecheck:storybook": "tsc --noEmit -p .storybook/tsconfig.json",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:watch": "vitest --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-storybook-bundle-size": "node scripts/check-storybook-bundle-size.mjs",
    "check-component-bundle-size": "node scripts/check-component-bundle-size.mjs",
    "check-foundations-token-coverage": "node scripts/check-foundations-token-coverage.mjs",
    "check-guidelines": "node scripts/check-guidelines.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@dbm-system/icons": "workspace:*",
    "@dbm-system/tokens": "workspace:*",
    "@dbm-system/utils": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-focus-scope": "^1.1.12",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-portal": "^1.1.13",
    "@radix-ui/react-presence": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.7"
  },
  "devDependencies": {
    "@dbm-system/eslint-config": "workspace:*",
    "@dbm-system/tsconfig": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^10.7.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
