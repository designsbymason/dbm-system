{
  "name": "@dbm-system/icons",
  "version": "0.0.0",
  "description": "Typed Phosphor Icons wrapper for the DBM System.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designsbymason/dbm-system.git",
    "directory": "packages/icons"
  },
  "homepage": "https://dbm-system.com",
  "bugs": {
    "url": "https://github.com/designsbymason/dbm-system/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  },
  "devDependencies": {
    "@dbm-system/eslint-config": "workspace:*",
    "@dbm-system/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
