{
  "name": "dbm-system",
  "private": true,
  "description": "An agentic React component library for building web and enterprise applications quickly, consistently and accessibly, with a typed, token-driven API that AI coding agents and developers can both rely on.",
  "license": "MIT",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-guidelines": "pnpm --filter @dbm-system/components check-guidelines",
    "check-publish": "node scripts/check-publish.mjs",
    "check-radix-single-copy": "node scripts/check-radix-single-copy.mjs",
    "check-manifest": "node scripts/check-manifest.mjs",
    "sync-agents": "node scripts/sync-agents.mjs",
    "check-fresh-app": "node scripts/check-fresh-app.mjs",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "check-action-pins": "node scripts/check-action-pins.mjs",
    "test:scripts": "node --test scripts/check-action-pins.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "turbo": "^2.11.11"
  }
}
