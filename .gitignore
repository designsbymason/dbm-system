# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.turbo/
coverage/
storybook-static/
*.tsbuildinfo

# Playwright (visual regression) — ephemeral run output; committed *-snapshots/
# baseline images are intentionally NOT ignored
playwright-report/
blob-report/
test-results/

# Env files
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local credential/config files
*.pem
*.key
.npmrc

# Docs website (apps/docs): generated output, rebuilt on every deploy
apps/docs/dist/
apps/docs/.astro/
apps/docs/public/pagefind/
apps/docs/public/manifest.json
apps/docs/public/llms.txt
apps/docs/public/llms-full.txt

# Private notes: anything personal, private or sensitive (guidelines/docs-site/06-gitignore-and-private-notes.md)
.local/
